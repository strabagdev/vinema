{
  "name": "vinema",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "server",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @vinema/sync-contracts",
    "dev": "next dev",
    "server:dev": "npm run dev --workspace server",
    "server:start": "npm run start --workspace server",
    "prebuild": "npm run build --workspace @vinema/sync-contracts",
    "build": "next build",
    "server:build": "npm run build --workspace server",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @vinema/sync-contracts",
    "test": "vitest",
    "pretest:run": "npm run build --workspace @vinema/sync-contracts",
    "test:run": "vitest run",
    "server:test": "npm run test --workspace server",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "sync:test-api": "tsx scripts/test-sync-api.ts",
    "sync:test-e2e": "node scripts/test-sync-e2e.mjs",
    "auth:test-api": "npm run sync:test-api",
    "test:sync-api": "npm run sync:test-api",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@vinema/sync-contracts": "file:packages/sync-contracts",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
